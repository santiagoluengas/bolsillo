# Clave que usa el atajo del iPhone. `npm run setup` la genera sola.
BOLSILLO_SECRET=

# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cliente OAuth de Google Cloud, tipo "App de escritorio"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# `npm run google-auth` lo escribe solo.
GOOGLE_REFRESH_TOKEN=

# URL pública del despliegue, sin "/" final. Ej: https://bolsillo.vercel.app
PUBLIC_URL=

# Opcionales
TIMEZONE=America/Bogota
DRIVE_FOLDER_NAME=Bolsillo
